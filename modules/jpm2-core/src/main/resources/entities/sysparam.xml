<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:util="http://www.springframework.org/schema/util"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
    http://www.springframework.org/schema/util http://www.springframework.org/schema/util/spring-util-2.5.xsd">

    <bean id="dao-sysparam" class="jpaoletti.jpm2.core.dao.DefaultJPADAO">
        <property name="transformer" ref="transformer-strToLong" />
        <property name="className" value="jpaoletti.jpm2.core.model.persistent.Sysparam" />
    </bean>
    <bean id="sysparam" class="jpaoletti.jpm2.core.model.Entity">
        <property name="clazz" value="jpaoletti.jpm2.core.model.persistent.Sysparam" />
        <property name="dao" ref="dao-sysparam" />
        <property name="pageSize" value="50" />
        <property name="defaultSortField" value="group" />
        <property name="detailedAudit" value="true" />
        <property name="operations">
            <list>
                <ref bean="compact-list-operation" />
                <ref bean="default-show-operation" />
                <bean class="jpaoletti.jpm2.core.model.Operation">
                    <property name="id" value="setValue" />
                    <property name="display" value="list show" />
                    <property name="useFields" value="false" />
                    <property name="executor">
                        <bean class="jpaoletti.jpm2.core.service.executors.SetSysparamValueExec" />
                    </property>
                    <property name="color" value="btn-primary" />
                    <property name="icon" value="fas fa-pen" />
                </bean>
                <bean class="jpaoletti.jpm2.core.model.Operation">
                    <property name="id" value="edit" />
                    <property name="display" value="none" />
                    <property name="useFields" value="false" />
                    <property name="executor" ref="operationExecutorEdit" />
                    <property name="icon" value="fas fa-edit" />
                </bean>
                <bean class="jpaoletti.jpm2.core.model.Operation">
                    <property name="id" value="clearCache" />
                    <property name="display" value="list show" />
                    <property name="executor">
                        <bean class="jpaoletti.jpm2.core.service.executors.ClearSysparamCacheExec" />
                    </property>
                    <property name="color" value="btn-info text-light" />
                    <property name="icon" value="fas fa-sync" />
                </bean>
                <bean class="jpaoletti.jpm2.core.model.Operation">
                    <property name="id" value="clearAllCache" />
                    <property name="scope" value="GENERAL" />
                    <property name="display" value="list" />
                    <property name="follows" value="list" />
                    <property name="confirm" value="true" />
                    <property name="executor">
                        <bean class="jpaoletti.jpm2.core.service.executors.ClearSysparamCacheExec" />
                    </property>
                    <property name="color" value="btn-info text-light" />
                    <property name="icon" value="fas fa-sync" />
                </bean>
                <bean class="jpaoletti.jpm2.core.model.Operation">
                    <property name="id" value="sysparamHealth" />
                    <property name="scope" value="GENERAL" />
                    <property name="display" value="list" />
                    <property name="follows" value="list" />
                    <property name="executor">
                        <bean class="jpaoletti.jpm2.core.service.executors.SysparamHealthExec" />
                    </property>
                    <property name="color" value="btn-warning" />
                    <property name="icon" value="fas fa-stethoscope" />
                </bean>
                <bean class="jpaoletti.jpm2.core.model.Operation">
                    <property name="id" value="sysparamTree" />
                    <property name="scope" value="GENERAL" />
                    <property name="display" value="list" />
                    <property name="follows" value="list" />
                    <property name="executor">
                        <bean class="jpaoletti.jpm2.core.service.executors.SysparamTreeExec" />
                    </property>
                    <property name="color" value="btn-secondary" />
                    <property name="icon" value="fas fa-sitemap" />
                </bean>
                <bean class="jpaoletti.jpm2.core.model.Operation">
                    <property name="id" value="import" />
                    <property name="scope" value="GENERAL" />
                    <property name="display" value="list" />
                    <property name="follows" value="list" />
                    <property name="executor">
                        <bean class="jpaoletti.jpm2.web.executors.ImportExec" />
                    </property>
                    <property name="color" value="btn-success" />
                    <property name="icon" value="fas fa-file-import" />
                </bean>
                <bean class="jpaoletti.jpm2.core.model.Operation">
                    <property name="id" value="export" />
                    <property name="display" value="list show" />
                    <property name="follows" value="show" />
                    <property name="executor">
                        <bean class="jpaoletti.jpm2.web.executors.ExportExec" />
                    </property>
                    <property name="color" value="btn-secondary" />
                    <property name="icon" value="fas fa-file-export" />
                </bean>
                <bean class="jpaoletti.jpm2.core.model.Operation">
                    <property name="id" value="exportSelected" />
                    <property name="scope" value="SELECTED" />
                    <property name="display" value="list" />
                    <property name="follows" value="list" />
                    <property name="executor">
                        <bean class="jpaoletti.jpm2.web.executors.ExportExec" />
                    </property>
                    <property name="color" value="btn-secondary" />
                    <property name="icon" value="fas fa-file-download" />
                </bean>
                <ref bean="default-itemAudit-operation" />
            </list>
        </property>
        <property name="fields">
            <list>
                <ref bean="id-invisible" />
                <bean class="jpaoletti.jpm2.core.model.Field">
                    <property name="id" value="group" />
                    <property name="width" value="140px" />
                    <property name="searcher" ref="jpm-searcher-string-jpa" />
                    <property name="configs" ref="read-only-config" />
                </bean>
                <bean class="jpaoletti.jpm2.core.model.Field">
                    <property name="id" value="key" />
                    <property name="searcher" ref="jpm-searcher-string-jpa" />
                    <property name="configs" ref="read-only-config" />
                </bean>
                <bean class="jpaoletti.jpm2.core.model.Field">
                    <property name="id" value="type" />
                    <property name="width" value="110px" />
                    <property name="searcher" ref="enumJPASearcher" />
                    <property name="configs" ref="enum-config-nn" />
                </bean>
                <bean class="jpaoletti.jpm2.core.model.Field">
                    <property name="id" value="value" />
                    <property name="sortable" value="false" />
                    <property name="configs">
                        <list>
                            <bean class="jpaoletti.jpm2.core.model.FieldConfig">
                                <property name="operations" value="list" />
                                <property name="converter">
                                    <bean class="jpaoletti.jpm2.web.converter.SysparamValueConverter" />
                                </property>
                            </bean>
                            <bean class="jpaoletti.jpm2.core.model.FieldConfig">
                                <property name="operations" value="show" />
                                <property name="converter">
                                    <bean class="jpaoletti.jpm2.web.converter.SysparamValueConverter">
                                        <property name="reveal" value="true" />
                                    </bean>
                                </property>
                            </bean>
                        </list>
                    </property>
                </bean>
                <bean class="jpaoletti.jpm2.core.model.Field">
                    <property name="id" value="cached" />
                    <property name="width" value="70px" />
                    <property name="align" value="center" />
                    <property name="searcher" ref="jpm-searcher-bool-jpa" />
                    <property name="configs" ref="inline-bool-config" />
                </bean>
                <bean class="jpaoletti.jpm2.core.model.Field">
                    <property name="id" value="updatedBy" />
                    <property name="width" value="120px" />
                    <property name="configs" ref="read-only-config" />
                </bean>
                <bean class="jpaoletti.jpm2.core.model.Field">
                    <property name="id" value="updatedAt" />
                    <property name="width" value="200px" />
                    <property name="configs" ref="ro-full-datetime-config" />
                </bean>
            </list>
        </property>
        <property name="panels">
            <list>
                <bean class="jpaoletti.jpm2.core.model.PanelRow">
                    <property name="panels">
                        <list>
                            <bean class="jpaoletti.jpm2.core.model.Panel">
                                <property name="icon" value="" />
                                <property name="title" value="" />
                                <property name="blocks" value="6" />
                                <property name="fields" value="id group key type value cached updatedBy updatedAt" />
                            </bean>
                        </list>
                    </property>
                </bean>
            </list>
        </property>
    </bean>
</beans>
